{
  "name": "unitypackage-extractor",
  "version": "1.1.0",
  "description": "Extract .unitypackage files from the command line",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "unitypackage-extractor": "dist/cli.js",
    "package-extractor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "keywords": [
    "unity",
    "unitypackage",
    "extract",
    "cli"
  ],
  "author": "Maoyeedy",
  "license": "MIT",
  "dependencies": {
    "sanitize-filename": "^1.6.3",
    "unitypackage-core": "file:../unitypackage-core"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "globals": "^16.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Maoyeedy/unitypackage-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/Maoyeedy/unitypackage-extractor/issues"
  },
  "homepage": "https://github.com/Maoyeedy/unitypackage-extractor#readme"
}
